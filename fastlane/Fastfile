# CI and release lanes for the Twilio Verify Passkeys KMP SDK.
#
# GitHub Actions (.github/workflows) calls these lanes; they can also be run
# locally with `bundle exec fastlane <lane>`. See README.md in this folder for
# the full list.
#
# Lane code runs from the fastlane/ folder and actions run from the repo root,
# so every path below is built from repo_root to avoid depending on either.

require 'digest'
require 'fileutils'

default_platform(:android)

IOS_REPO = "twilio/twilio-verify-passkeys-ios"
XCFRAMEWORK_NAME = "TwilioPasskeysAuthentication.xcframework"
PLATFORMS = {
  kmp: { ios_only: false, property: "kmpSdkVersionName", suffix: "-kmp" },
  ios: { ios_only: true, property: "iosSdkVersionName", suffix: "-ios" }
}.freeze

def repo_root
  @repo_root ||= File.expand_path("..", __dir__)
end

def root_path(*parts)
  File.join(repo_root, *parts)
end

# Runs a shell command from the repo root and returns its output.
def sh_root(command, log: true)
  Dir.chdir(repo_root) { sh(command, log: log) }
end

def gradle_tasks(*tasks, properties: {}, flags: nil)
  gradle(tasks: tasks.flatten, project_dir: repo_root, properties: properties, flags: flags, print_command: true)
end

def gradle_property(name)
  File.read(root_path("gradle.properties"))[/^#{name}\s*=\s*(\S+)\s*$/, 1].to_s
end

# Writes key=value pairs to $GITHUB_OUTPUT so later workflow steps can use them.
def github_output(values)
  values.each { |key, value| UI.message("#{key}=#{value}") }
  path = ENV["GITHUB_OUTPUT"].to_s
  return if path.empty?

  File.open(path, "a") { |f| values.each { |key, value| f.puts("#{key}=#{value}") } }
end

# The temp dir GitHub gives each job, or a fresh one locally.
def temp_dir
  @temp_dir ||= ENV["RUNNER_TEMP"].to_s.empty? ? Dir.mktmpdir : ENV["RUNNER_TEMP"]
end

def require_env(name)
  value = ENV[name].to_s
  # GitHub passes secrets to fork PRs as empty strings.
  UI.user_error!("#{name} is not set. Pull requests from forks don't receive secrets.") if value.empty?
  value
end

def tag_exists?(tag, repo: nil)
  remote = repo ? "https://github.com/#{repo}.git" : "origin"
  system("git", "ls-remote", "--exit-code", "--tags", remote, "refs/tags/#{tag}", out: File::NULL, chdir: repo_root)
end

# The CHANGELOG.md entry titled "# <tag>", without its title line.
def changelog_entry(tag)
  lines = File.readlines(root_path("CHANGELOG.md"), chomp: true)
  start = lines.index("# #{tag}")
  UI.user_error!("CHANGELOG.md has no '# #{tag}' entry. Release PRs come from the Prepare release workflow.") unless start
  rest = lines[(start + 1)..]
  finish = rest.index { |line| line.start_with?("# ") } || rest.length
  entry = rest[0...finish].join("\n").strip
  UI.user_error!("The '# #{tag}' entry in CHANGELOG.md is empty.") if entry.empty?
  entry
end

def write_notes_file(tag)
  path = File.join(temp_dir, "release-notes-#{tag}.md")
  File.write(path, "#{changelog_entry(tag)}\n")
  path
end

# Makes apkanalyzer (used by the generateSizeReport task) available, installing
# the SDK cmdline-tools when the runner doesn't have them.
def ensure_apkanalyzer
  return if system("command -v apkanalyzer >/dev/null 2>&1")

  sdk_dir = [ENV["ANDROID_HOME"], ENV["ANDROID_SDK_ROOT"]].map(&:to_s).find { |dir| !dir.empty? } || File.join(Dir.home, "android-sdk")
  candidates = ["#{sdk_dir}/cmdline-tools/latest/bin"] + Dir["#{sdk_dir}/cmdline-tools/*/bin"] + ["#{sdk_dir}/tools/bin"]
  bin_dir = candidates.find { |dir| File.executable?(File.join(dir, "apkanalyzer")) }

  unless bin_dir
    sdkmanager = candidates.map { |dir| File.join(dir, "sdkmanager") }.find { |path| File.executable?(path) }
    UI.user_error!("No apkanalyzer or sdkmanager under #{sdk_dir}; install the Android SDK cmdline-tools on the runner.") unless sdkmanager
    sh("yes | #{sdkmanager.shellescape} 'cmdline-tools;latest'")
    bin_dir = "#{sdk_dir}/cmdline-tools/latest/bin"
  end

  ENV["PATH"] = "#{bin_dir}#{File::PATH_SEPARATOR}#{ENV['PATH']}"
  UI.message("apkanalyzer: #{bin_dir}")
end

def zip_xcframework(build_type, output)
  link = root_path(XCFRAMEWORK_NAME)
  FileUtils.rm_f([link, output])
  File.symlink(root_path("shared/build/XCFrameworks/#{build_type}/#{XCFRAMEWORK_NAME}"), link)
  sh_root("zip -r #{output.shellescape} #{XCFRAMEWORK_NAME}", log: false)
ensure
  FileUtils.rm_f(link)
end

