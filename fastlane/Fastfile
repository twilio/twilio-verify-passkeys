desc "Assemble the SDK, the Android sample app and the instrumented test APK, and collect them in builds/"
lane :assemble do
  gradle_tasks("assembleDebug", ":shared:assembleRelease", "assembleDebugAndroidTest")
  FileUtils.mkdir_p(root_path("builds"))
  FileUtils.cp_r(Dir[root_path("shared/build/outputs/apk/androidTest/debug/*")], root_path("builds"))
  FileUtils.cp_r(root_path("shared/build/outputs/aar"), root_path("builds"))
end

desc "Check the Kotlin code style with ktlint"
lane :lint do
  gradle_tasks("ktlintCheck")
end

desc "Run detekt"
lane :detekt do
  gradle_tasks("detekt")
end

desc "Run the Android unit tests with Kover coverage and enforce the coverage rule"
lane :android_unit_tests do
  gradle_tasks(":shared:koverXmlReportDebug", ":shared:koverVerify")
end

desc "Run the iOS unit tests on the arm64 simulator"
lane :ios_unit_tests do
  gradle_tasks(":shared:iosSimulatorArm64Test")
end

desc "Generate the Android SDK size report"
lane :android_size_report do
  ensure_apkanalyzer
  # A running daemon would keep its old PATH and miss apkanalyzer.
  gradle_tasks("generateSizeReport", flags: "--no-daemon")
end

desc "Run the instrumented tests in Firebase Test Lab (gcloud must be authenticated)"
lane :instrumented_tests do
  sh_root(
    "gcloud firebase test android run --app ftl/dummy.apk --test builds/shared-debug-androidTest.apk " \
    "--device model=tokay,version=35,locale=en,orientation=portrait"
  )
end

desc "Add a JUnit results table to the GitHub job summary. Options: title"
lane :test_summary do |options|
  title = options.fetch(:title)
  files = Dir[root_path("**/build/test-results/**/*.xml")]
  totals = Hash.new(0)
  failing = []

  files.each do |file|
    xml = File.read(file)
    xml.scan(/<testsuite\s[^>]*>/).each do |suite|
      %w[tests failures errors skipped].each { |key| totals[key] += suite[/\s#{key}="(\d+)"/, 1].to_i }
      totals["time"] += suite[/\stime="([\d.]+)"/, 1].to_f
    end
    xml.scan(%r{<testcase\s([^>]*?)(?:/>|>(.*?)</testcase>)}m).each do |attrs, body|
      next unless body.to_s =~ /<(failure|error)[\s>]/

      failing << "#{attrs[/classname="([^"]*)"/, 1]}.#{attrs[/(?:\A|\s)name="([^"]*)"/, 1]}"
    end
  end

  summary =
    if files.empty?
      "### #{title}\n\n> No JUnit test results were found.\n"
    else
      failed = totals["failures"] + totals["errors"]
      passed = totals["tests"] - failed - totals["skipped"]
      status = failed.zero? ? "✅ Passed" : "❌ Failed"
      text = +"### #{title} — #{status}\n\n"
      text << "| Total | Passed | Failed | Errors | Skipped | Time (s) |\n"
      text << "| ----- | ------ | ------ | ------ | ------- | -------- |\n"
      text << "| #{totals['tests']} | #{passed} | #{totals['failures']} | #{totals['errors']} | #{totals['skipped']} | #{format('%.3f', totals['time'])} |\n"
      text << "\n<details><summary>Failing tests</summary>\n\n#{failing.map { |t| "- `#{t}`" }.join("\n")}\n\n</details>\n" unless failing.empty?
      text
    end

  path = ENV["GITHUB_STEP_SUMMARY"].to_s
  path.empty? ? UI.message(summary) : File.write(path, "#{summary}\n", mode: "a")
end

desc "Run a Danger check on the current PR. Options: id, dangerfile (a file in dangerfiles/)"
lane :danger_check do |options|
  danger(
    danger_id: options.fetch(:id),
    dangerfile: root_path("dangerfiles", options.fetch(:dangerfile)),
    github_api_token: require_env("DANGER_GITHUB_API_TOKEN"),
    remove_previous_comments: true,
    verbose: true
  )
end

